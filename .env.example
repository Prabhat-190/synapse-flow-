# ATLAS Orchestrator Configuration
ATLAS_ENV=development
ATLAS_API_KEY=dev-secret-key-change-in-production

# LLM Providers
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
FALLBACK_MODEL=gemini-1.5-flash

# Database
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
SYNC_DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Context Budget
MAX_CONTEXT_TOKENS=128000
COMPRESSION_THRESHOLD=0.85
NEVER_SILENT_TRUNCATION=true

# Security
PROMPT_INJECTION_THRESHOLD=0.7
RATE_LIMIT_RPM=60

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
